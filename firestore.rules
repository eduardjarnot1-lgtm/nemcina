rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Every learner owns exactly one private document tree. Client-side Firebase
    // configuration never grants access; the authenticated UID below does.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
