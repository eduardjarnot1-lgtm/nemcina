{
  "name": "@nemcina/mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@nemcina/core": "*",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~57.0.22",
    "expo-constants": "~57.0.18",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.3",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "firebase": "^12.19.0",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "playwright-core": "^1.63.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web --output-dir dist",
    "publish:web": "expo export --platform web --output-dir dist --clear && node tools/prepare-web-artifact.mjs dist web-artifact",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node e2e/smoke.mjs",
    "test": "node e2e/smoke.mjs",
    "build:pages": "EXPO_BASE_URL=/nemcina expo export --platform web --output-dir dist-pages --clear && node tools/finish-pages.mjs dist-pages"
  },
  "private": true
}
