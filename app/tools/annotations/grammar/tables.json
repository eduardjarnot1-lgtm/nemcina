    "g-l06-3": [
      {
        "caption": "Which reference word, and what it points at",
        "columns": [
          "expression",
          "points back at",
          "meaning / use",
          "example",
          "translation"
        ],
        "rows": [
          [
            "das",
            "a whole statement",
            "the thing just said, treated as one thing",
            "Das kannte ich so nicht.",
            "I did not know it like that."
          ],
          [
            "dem",
            "a dative object",
            "after verbs that take the dative: zustimmen, widersprechen, folgen",
            "Dem stimme ich zu.",
            "I agree with that."
          ],
          [
            "da",
            "a place or a situation",
            "there, in that situation",
            "Da habe ich immer Ansprechpartner gefunden.",
            "That is where I always found someone to turn to."
          ],
          [
            "stattdessen",
            "what was just said",
            "instead — the first thing does not happen, this does",
            "Stattdessen lernen wir in den Ferien.",
            "Instead we study in the holidays."
          ],
          [
            "dafür",
            "what was just said",
            "in return — a compensation, not a replacement",
            "Dafür lernen wir in den Ferien umso mehr.",
            "In return we study all the more in the holidays."
          ],
          [
            "dadurch",
            "a means or a cause",
            "by that / because of that",
            "Dadurch bleibt wenig Energie.",
            "That leaves little energy."
          ],
          [
            "dementsprechend",
            "a consequence",
            "accordingly — in keeping with what was said",
            "Dementsprechend plant man anders.",
            "One plans differently accordingly."
          ],
          [
            "infolgedessen",
            "a consequence",
            "consequently — it follows in time, as an effect",
            "Infolgedessen fehlt die Zeit.",
            "Consequently there is no time."
          ],
          [
            "demzufolge",
            "a consequence",
            "according to that — drawing a conclusion from it",
            "Demzufolge braucht man Weiterbildung.",
            "It follows that further training is needed."
          ]
        ],
        "emphasis": [
          [
            0,
            0
          ],
          [
            1,
            0
          ],
          [
            2,
            0
          ]
        ],
        "emphasisNote": "The first three point back at a thing, a case or a place. The rest join one clause to the next.",
        "key": [
          {
            "symbol": "stattdessen vs dafür",
            "means": "stattdessen replaces (the first thing does not happen); dafür compensates (it still happened, and this makes up for it). They are not interchangeable."
          },
          {
            "symbol": "dementsprechend vs infolgedessen vs demzufolge",
            "means": "dementsprechend = in keeping with it; infolgedessen = as an effect of it; demzufolge = concluding from it. All three translate loosely as “as a result”, which is why they get confused."
          }
        ]
      }
    ],
