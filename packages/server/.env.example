# Copy to .env and fill in. Never commit a filled-in copy.
#
# TOKEN_PEPPER has no default. In production the server refuses to start
# without it; in development it generates an ephemeral one that resets on every
# restart, so there is nothing to leak and nothing to forget to change.
#
# Generate one with:  node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
TOKEN_PEPPER=<generate one; never reuse across environments>

NODE_ENV=development
PORT=8080
DATABASE_PATH=:memory:

SESSION_DAYS=30
SIGN_IN_ATTEMPTS=10
SIGN_IN_WINDOW_MS=900000

# Browser origins allowed to call this API, comma separated. Empty means no
# CORS headers at all, which is right for a mobile-only deployment. There is no
# wildcard: name each origin.
CORS_ORIGINS=

# The coach's language model. Leaving this unset is a supported state: the app
# falls back to the deterministic advice it computes from the learner's own
# records and says that no model is configured. It is never a placeholder that
# silently ships.
ANTHROPIC_API_KEY=<set to enable the coach; leave empty to run without it>
AI_MODEL=claude-opus-5

# Coach requests per day. This is the only thing premium currently buys, and it
# is counted server-side because the client must not be trusted with it.
COACH_FREE_PER_DAY=5
COACH_PREMIUM_PER_DAY=50
